{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "react",
      "react-native",
      "expo"
    ],
    "jsx": "react-native",
    "module": "esnext",
    "strict": true
  },
  "include": [
    "src",
    "app",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "expo": {
    "extra": {
      "API_URL": "http://10.0.2.2:5000"
    }
  }
}